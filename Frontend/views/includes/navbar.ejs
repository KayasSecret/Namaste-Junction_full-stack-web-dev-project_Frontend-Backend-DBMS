<nav class="navbar navbar-expand-lg nj-navbar sticky-top" id="njMainNavbar" aria-label="Primary Navigation">
  <div class="container nj-nav-container">
    <!-- Brand Logo & Identity -->
    <a class="navbar-brand nj-brand" href="/listings" aria-label="Namaste Junction Home">
      <span class="nj-brand-icon-wrap">
        <i class="fa-regular fa-compass nj-compass-icon" aria-hidden="true"></i>
      </span>
      <span class="nj-brand-text">
        <span class="nj-brand-title">Namaste<span>Junction</span></span>
        <span class="nj-brand-tag">Stays &amp; Experiences</span>
      </span>
    </a>

    <!-- Mobile Hamburger Toggler -->
    <button
      class="navbar-toggler nj-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="nj-toggler-bar"></span>
      <span class="nj-toggler-bar"></span>
      <span class="nj-toggler-bar"></span>
    </button>

    <!-- Collapsible Navigation Content -->
    <div class="collapse navbar-collapse nj-nav-collapse" id="navbarNavAltMarkup">
      <!-- Left Primary Link -->
      <div class="navbar-nav nj-nav-left">
        <a class="nav-link nj-nav-link" href="/listings" data-nav-path="/listings">
          <i class="fa-solid fa-earth-asia nj-link-icon" aria-hidden="true"></i>
          <span>Explore</span>
        </a>
      </div>

      <!-- Center Interactive Destination Search Bar -->
      <div class="navbar-nav mx-lg-auto my-2 my-lg-0 nj-search-wrapper">
        <form class="d-flex nj-search-form" role="search" action="/listings" method="GET" id="njSearchForm">
          <div class="nj-search-pill">
            <i class="fa-solid fa-location-dot nj-search-pin" aria-hidden="true"></i>
            <input
              class="form-control search-input nj-search-input"
              type="search"
              name="q"
              id="njDestinationSearch"
              placeholder="Search destinations, villas, cities..."
              aria-label="Search destinations"
              autocomplete="off"
            >
            <button class="btn btn-search nj-btn-search" type="submit" aria-label="Search">
              <i class="fa fa-search" aria-hidden="true"></i>
              <span>Search</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Right Actions & Auth Menu -->
      <div class="navbar-nav ms-lg-auto align-items-lg-center nj-nav-right">
        <a class="nav-link nj-host-pill" href="/listings/new" data-nav-path="/listings/new">
          <i class="fa-solid fa-plus-circle" aria-hidden="true"></i>
          <span>Add new Listing</span>
        </a>

        <div class="nj-auth-divider d-none d-lg-block" aria-hidden="true"></div>

        <% if (!locals.currUser) { %>
          <div class="nj-auth-group">
            <a class="nj-btn-login" href="/login" data-nav-path="/login">
              <i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i>
              <span>Log in</span>
            </a>
            <a class="nj-btn-signup" href="/signup" data-nav-path="/signup">
              <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
              <span>Sign up</span>
            </a>
          </div>
        <% } %>

        <% if (locals.currUser) { %>
          <div class="nj-auth-group nj-user-logged">
            <span class="nj-user-badge" title="Signed in as <%= currUser.username %>">
              <span class="nj-user-avatar" aria-hidden="true">
                <%= currUser.username ? currUser.username.charAt(0).toUpperCase() : "U" %>
              </span>
              <span class="nj-user-name"><%= currUser.username %></span>
            </span>
            <a class="nj-btn-logout" href="/logout">
              <i class="fa-solid fa-power-off" aria-hidden="true"></i>
              <span>Log out</span>
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>